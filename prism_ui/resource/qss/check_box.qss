CheckBox[class="CheckBox"] {
    color: --ThemeColor_Checkbox_Text_Default;
    font-family: --ThemeFont_Button_Font_Family;
    font-size: --ThemeFont_Button_Font_Size;
    font-weight: --ThemeFont_Button_Font_Weight;
    spacing: 8px;
    min-width: 28px;
    min-height: 22px;
    outline: none;
    margin-left: 1px;
}

CheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid transparent;
    background-color: transparent;
}

CheckBox:disabled {
    color: --ThemeColor_Checkbox_Text_Disabled;
}